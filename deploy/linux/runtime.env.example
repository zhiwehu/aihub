AIHUB_WEB_ROOT=/opt/aihub/apps/admin-web/public
AIHUB_FIRMWARE_ROOT=/var/lib/aihub/flash
AIHUB_CLIENT_ROOT=/opt/aihub/.artifacts/client-web
AIHUB_MODELS_URL=http://127.0.0.1:8790
# Set the same randomly generated token for server and processing.
AIHUB_MODELS_TOKEN=REPLACE_WITH_RANDOM_TOKEN
AIHUB_MINUTES_PROVIDER=http
AIHUB_MINUTES_URL=http://127.0.0.1:1234/v1
AIHUB_MINUTES_MODEL=REPLACE_WITH_ACTUAL_LLM_ID
AIHUB_MINUTES_KEY_ENV=VOICE_LLM_KEY
AIHUB_MEDIA_ASR_PROVIDER=http
AIHUB_MEDIA_ASR_URL=http://127.0.0.1:8000/v1
AIHUB_MEDIA_ASR_MODEL=REPLACE_WITH_ACTUAL_ASR_ID
AIHUB_MEDIA_ASR_KEY_ENV=VOICE_ASR_KEY
