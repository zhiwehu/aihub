# Deployment paths, ports and model endpoints. Copy to .env before the first
# start; compose reads it for interpolation. Never commit real paths or tokens.

# Runtime data: recordings, history, settings.json, tokens. When the model tier
# runs natively on the same host it must point at this same directory.
AIHUB_DATA=/absolute/path/to/data

# Verified client artifact installed by scripts/install-client.py
# (for example <repo>/.artifacts/client-web). Mounted read-only at
# /app/client-web; the 8768 listener serves /demo/ from it.
AIHUB_CLIENT_ROOT=/absolute/path/to/client-web

# Music (read-only) and file-organiser (read-write) folders. The same absolute
# path is mounted inside the container, so the paths in settings.json keep
# working in either deployment mode.
AIHUB_MUSIC_DIR=/absolute/path/to/music
AIHUB_FILES_DIR=/absolute/path/to/files

# Firmware flashing release (optional: without it the console hides the panel).
AIHUB_FIRMWARE_DIR=/absolute/path/to/aihub-firmware/flash

# LAN address devices are told to dial. A container cannot discover the host NIC.
AIHUB_DEVICE_HOST=192.168.1.100
AIHUB_DEVICE_BIND=0.0.0.0

# Published ports.
AIHUB_CONTAINER_PORT=8765
AIHUB_CLIENT_PORT=8768
AIHUB_DEVICE_PORT=8766

# Container-side address of the processing service. Leave it unset for the
# published-port deployment (compose defaults to http://processing:8790);
# compose.host.yaml overrides it to http://127.0.0.1:8790.
# AIHUB_MODELS_URL=http://processing:8790

# OpenAI-compatible endpoints for minutes / retranscription / diarisation.
# Use the same endpoints the console configures; keys live in env/models.env.
# macOS native MLX workers:
ASR_URL=http://host.docker.internal:8781/v1
ASR_MODEL=mlx-community/Qwen3-ASR-0.6B-8bit
LLM_URL=http://host.docker.internal:8782/v1
LLM_MODEL=mlx-community/Qwen3-4B-Instruct-2507-4bit

# Private-protocol model services (AtomGradient) use the optional bridge
# profile instead of direct HTTP. Uncomment when the provider needs it; the
# console then points TTS/ASR at http://bridge:18095/v1.
# COMPOSE_PROFILES=bridge
# ATOM_ASR_URL=http://host.docker.internal:18094/v1/asr
# ATOM_TTS_HTTP_URL=http://host.docker.internal:18094/api/v1/tts
# ATOM_TTS_WS_URL=ws://host.docker.internal:18093/api/v3/tts/bidirection
# ATOM_HEALTH_URL=http://host.docker.internal:18094/health
# TTS_MODE=ws

# Image tags. The offline bundle pins these; local builds default to the values
# in compose.yaml.
# AIHUB_CORE_IMAGE=aihub-core:local
# AIHUB_PROCESSING_IMAGE=aihub-processing:local
