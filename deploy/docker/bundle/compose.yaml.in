name: aihub-225h
services:
  processing:
    image: aihub-processing:@TAG@
    network_mode: host
    restart: unless-stopped
    env_file: [model-keys.env]
    environment:
      AIHUB_MODELS_TOKEN: ${AIHUB_MODELS_TOKEN:?set in .env}
      AIHUB_MINUTES_PROVIDER: http
      AIHUB_MINUTES_URL: ${LLM_URL:?set LLM_URL}
      AIHUB_MINUTES_MODEL: ${LLM_MODEL:?set LLM_MODEL}
      AIHUB_MINUTES_KEY_ENV: VOICE_LLM_KEY
      AIHUB_MEDIA_ASR_PROVIDER: http
      AIHUB_MEDIA_ASR_URL: ${ASR_URL:?set ASR_URL}
      AIHUB_MEDIA_ASR_MODEL: ${ASR_MODEL:?set ASR_MODEL}
      AIHUB_MEDIA_ASR_KEY_ENV: VOICE_ASR_KEY
    volumes:
      - ${AIHUB_DEPLOY}/data:/data
  core:
    image: aihub-core:@TAG@
    network_mode: host
    restart: unless-stopped
    env_file: [model-keys.env]
    environment:
      AIHUB_MODELS_URL: http://127.0.0.1:8790
      AIHUB_MODELS_TOKEN: ${AIHUB_MODELS_TOKEN:?set in .env}
      AIHUB_CLIENT_ORIGINS: ${CLIENT_ORIGINS:-}
      AIHUB_CLIENT_PUBLIC_URL: ${CLIENT_PUBLIC_URL:-}
      AIHUB_LLM_THINKING: ${LLM_THINKING:-}
      AIHUB_REX_RUNTIME: /data/rex-runtime-linux
    volumes:
      - ${AIHUB_DEPLOY}/data:/data
      - ${AIHUB_DEPLOY}/music:/music:ro
    command: ["--data", "/data", "--host", "0.0.0.0", "--port", "8765",
              "--client-host", "0.0.0.0", "--client-port", "8768"]

  bridge:
    image: aihub-core:@TAG@
    network_mode: host
    pid: host
    restart: unless-stopped
    volumes:
      - ${AIHUB_DEPLOY}/bridge.py:/app/bridge.py:ro
    environment:
      TTS_MODE: ${TTS_MODE:-ws}
      TTS_WS_URL: ${TTS_WS_URL:-ws://127.0.0.1:18093/api/v3/tts/bidirection}
    entrypoint: ["python", "/app/bridge.py"]
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:18095/health', timeout=3)"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
