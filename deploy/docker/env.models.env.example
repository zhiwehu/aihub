# Secrets consumed via env_file by core and processing. chmod 600, never commit.
# Bearer keys are only needed when the model services require authentication.
VOICE_ASR_KEY=REPLACE_IF_REQUIRED_BY_ASR
VOICE_LLM_KEY=REPLACE_IF_REQUIRED_BY_LLM
VOICE_TTS_KEY=REPLACE_IF_REQUIRED_BY_TTS
# Shared token between core and the processing service (AIHUB_MODELS_URL).
AIHUB_MODELS_TOKEN=REPLACE_WITH_SHARED_PROCESSING_TOKEN
